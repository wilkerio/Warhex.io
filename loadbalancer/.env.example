# Port for /get-server endpoint
DIRECTORY_PORT=3002

# Public address returned to clients (host[:port], optionally with scheme)
# Examples:
# SERVER_ADDRESS=127.0.0.1:9090
# SERVER_ADDRESS=game.warhex.io
# SERVER_ADDRESS=https://game.warhex.io
SERVER_ADDRESS=127.0.0.1:9090

# Comma-separated browser origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ports where existing game servers are listening (when AUTO_SPAWN_SERVERS=false)
SERVER_PORTS=9090,9091
MAX_SERVER_COUNT=2
MAX_PLAYER_COUNT=24
SERVER_PORT_START=9090

# Optional: auto start game servers from this process
AUTO_SPAWN_SERVERS=false
SERVER_CWD=
