# Bind settings
PORT=9090
BIND_ADDRESS=127.0.0.1

# Auth API base URL used by Go server and network stats updater
AUTH_API_BASE_URL=http://127.0.0.1:3001

# Comma-separated origins allowed for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5502,http://127.0.0.1:5502

# Banco de dados dos bots
SUPABASE_DB_URL=postgres://postgres:[SUA_SENHA]@db.xxxx.supabase.co:5432/postgres

# Treinamento RL em background (true para ativar)
RUN_TRAINING=false

# Quantidade de bots na partida (padrao: 10, maximo: 32)
BOT_COUNT=10
